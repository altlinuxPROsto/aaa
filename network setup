4. Команды настройки устройств
ISP
enable
conf t
hostname ISP
 
enable secret securepass1
service password-encryption
 
line console 0
 password console123
 login
 logging synchronous
exit
 
ip domain-name example.com
username admin secret sshpassword1
crypto key generate rsa modulus 1024
ip ssh version 2
 
line vty 0 4
 login local
 transport input ssh
exit
 
interface g0/0
 description TO-R1
 ip address 10.0.0.1 255.255.255.252
 no shutdown
exit
 
interface g0/1
 description TO-R2
 ip address 10.0.0.5 255.255.255.252
 no shutdown
exit
 
end
